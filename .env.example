OFFICIUM_ENV=development
SECRET_KEY=
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
MAX_CONTENT_LENGTH=10485760
APP_TIMEZONE=UTC

# Каталог данных времени выполнения. Установщик прописывает
# <APP_DIR>/shared/instance; пусто — <каталог приложения>/instance (разработка).
OFFICIUM_INSTANCE_PATH=
# Импорт банковских выписок (см. docs/DEPLOYMENT.md, «Хранилище импорта»).
# Пусто — <OFFICIUM_INSTANCE_PATH>/bank_imports.
IMPORT_STORAGE_DIR=
IMPORT_PREVIEW_TTL_MINUTES=240
IMPORT_STORAGE_MAX_BYTES=33554432
IMPORT_STORAGE_MAX_FILES=500
IMPORT_MAX_PENDING_PER_USER=5
IMPORT_DISK_RESERVE_BYTES=536870912
IMPORT_MAX_CONCURRENT_PARSES=1
IMPORT_PARSE_WAIT_SECONDS=20
IMPORT_MAX_ROWS=500
IMPORT_MAX_SOURCE_ROWS=20000
# Пороги `flask storage-check` (таймер officium-maintenance): 1,5 ГиБ и 750 МиБ.
DISK_WARN_FREE_BYTES=1610612736
DISK_CRITICAL_FREE_BYTES=786432000
DATABASE_URL=
DB_ENGINE=sqlite
SQLITE_PATH=dev.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=officium
DB_PASSWORD=
DB_NAME=debt_manager

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LOGIN_ENABLED=false
TELEGRAM_MINI_APP_ENABLED=false
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_WEB_APP_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_WEB_FRAME_ANCESTORS=https://web.telegram.org
TELEGRAM_BOT_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PRIVATE_CHAT_ONLY=true
TELEGRAM_BOT_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_REMINDER_DAYS=7
TELEGRAM_UPDATE_RETENTION_DAYS=30
TELEGRAM_CONVERSATION_TTL_MINUTES=30

TEST_USER_ENABLED=false
TEST_USER_TELEGRAM_ID=-999999999999
TEST_USER_USERNAME=testuser
TEST_USER_FIRST_NAME=Тестовый
TEST_USER_LAST_NAME=Пользователь
TEST_USER_ROLE=user
DEV_LOGIN_ENABLED=false
# DEV_LOGIN_ENABLED используется только для локального тестирования. На сервере всегда должно быть false.
ADMIN_LOGIN_ENABLED=false
ADMIN_TELEGRAM_IDS=
ADMIN_PASSWORD_HASH=
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# Обновление сервера из админки. Оставьте выключенным до установки
# root-owned socket-activated службы по инструкции в docs/DEPLOYMENT.md.
# APP_VERSION=v0.0.6
SERVER_UPDATE_ENABLED=false
SERVER_UPDATE_REPOSITORY=<repository-owner>/officium
SERVER_UPDATE_SOCKET=/run/officium/updater.sock
SERVER_UPDATE_APP_DIR=/opt/officium/current
SERVER_UPDATE_STATUS_PATH=/var/lib/officium/server-update-status.json
SERVER_UPDATE_HTTP_TIMEOUT_SECONDS=8
SERVER_UPDATE_IPC_TIMEOUT_SECONDS=8
SERVER_UPDATE_STALE_MINUTES=120

GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
