server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAME@@;

    # Terminate HTTPS here in production (for example with Certbot) and keep
    # Waitress bound to loopback only.
    client_max_body_size 10m;

    # Static files are served by the application through this proxy (with
    # Cache-Control and nosniff headers). Do not add `location /static/` with
    # an alias: nginx (www-data) cannot read the root:officium 0750 release
    # tree, and an alias into an old checkout breaks after an upgrade.
    location / {
        proxy_pass http://@@HOST@@:@@PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 60s;
    }
}
