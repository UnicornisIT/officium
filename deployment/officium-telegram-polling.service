[Unit]
Description=Receive officium Telegram commands
Wants=network-online.target
After=network-online.target
PartOf=@@SERVICE_NAME@@.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@@APP_USER@@
Group=@@APP_GROUP@@
WorkingDirectory=@@APP_ROOT@@/current
EnvironmentFile=@@APP_ROOT@@/shared/.env
ExecStart=@@VENV_DIR@@/bin/python -m flask --app run.py telegram-poll
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=@@APP_ROOT@@/shared

[Install]
WantedBy=multi-user.target @@SERVICE_NAME@@.service
