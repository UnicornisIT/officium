# Этот файл устанавливается как /etc/officium/updater.env и должен принадлежать root.
APP_DIR=/opt/officium/current
APP_USER=<service-user>
APP_GROUP=<service-group>
SERVICE_NAME=officium
GIT_REMOTE=origin
REPOSITORY=<repository-owner>/officium
STATUS_FILE=/var/lib/officium/server-update-status.json
STALE_MINUTES=120
BACKUP_DIR=/var/backups/officium
RELEASES_DIR=/opt/officium/releases
DEPLOY_SCRIPT=/usr/local/lib/officium/deploy-release
UPDATE_SOCKET=/run/officium/updater.sock
VENV_NAME=venv
# Ресурсы (значения по умолчанию рассчитаны на 1 vCPU / 1 ГиБ / 10 ГБ, см. docs/DEPLOYMENT.md).
# Сколько готовых релизов хранить: текущий + предыдущий (для отката) + ещё один. Минимум 2.
RELEASES_KEEP=3
# Свободное место, которое должно остаться после нового релиза и резервной копии БД;
# иначе обновление отменяется до любых изменений. Это же — критический порог отчёта.
UPDATE_MIN_FREE_MB=750
# MemAvailable + свободный swap перед обновлением (не меньше половины — из RAM).
UPDATE_MIN_MEMORY_MB=200
# Предупреждение в --disk-report при меньшем свободном месте.
DISK_WARN_FREE_MB=1536
# Необязательно: локальный URL, который должен отвечать HTTP 2xx/3xx после restart.
# Например: https://<your-domain>/login
HEALTHCHECK_URL=
