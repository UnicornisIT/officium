# Этот файл устанавливается как /etc/officium/updater.env и должен принадлежать root.
APP_DIR=/var/www/debt_manager
APP_USER=officium
SERVICE_NAME=debt_manager
GIT_REMOTE=origin
REPOSITORY=UnicornisIT/officium
STATUS_FILE=/var/lib/officium/server-update-status.json
BACKUP_DIR=/var/backups/officium
# Для публичного репозитория оставьте пустым. Для private repo укажите абсолютный
# путь к root-owned файлу, содержащему только GitHub token.
GITHUB_TOKEN_FILE=
