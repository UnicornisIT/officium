[Unit]
Description=Officium web application
Documentation=file:@@APP_ROOT@@/current/docs/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@@APP_USER@@
Group=@@APP_GROUP@@
WorkingDirectory=@@APP_ROOT@@/current
EnvironmentFile=@@APP_ROOT@@/shared/.env
ExecStart=@@VENV_DIR@@/bin/waitress-serve --listen=@@HOST@@:@@PORT@@ --threads=@@THREADS@@ --trusted-proxy=@@TRUSTED_PROXY@@ "--trusted-proxy-headers=@@TRUSTED_PROXY_HEADERS@@" run:app
Restart=on-failure
RestartSec=3s
TimeoutStartSec=60s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
UMask=0027
ReadWritePaths=@@APP_ROOT@@/shared

[Install]
WantedBy=multi-user.target
