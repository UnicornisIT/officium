[Unit]
Description=Send officium monthly expense reminders
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@@APP_USER@@
Group=@@APP_GROUP@@
WorkingDirectory=@@APP_ROOT@@/current
EnvironmentFile=@@APP_ROOT@@/shared/.env
ExecStart=@@VENV_DIR@@/bin/python -m flask --app run.py send-monthly-expense-reminders
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=@@APP_ROOT@@/shared
